NODE_ENV=development
# Ejemplos: reemplaza usuario/contraseña por los de tu instalación.
DATABASE_URL=postgresql://ipc_backend_app:change-me@127.0.0.1:5432/ipc_backend_dev
# Prisma puede reconstruir esta base auxiliar. Nunca usar la base principal aquí.
SHADOW_DATABASE_URL=postgresql://ipc_backend_app:change-me@127.0.0.1:5432/ipc_backend_shadow

# Origen exacto permitido; Bruno puede omitir Origin, pero requiere X-IPC-Client.
ADMIN_ORIGIN=http://localhost:5174
PORT=3000

# Obligatoria: clave aleatoria de 32 bytes en hexadecimal (64 caracteres).
# Generarla localmente; no versionar el valor real.
JWT_SECRET=

# Clave de cifrado TOTP independiente; generar con pnpm mfa:key
MFA_ENCRYPTION_KEY=
