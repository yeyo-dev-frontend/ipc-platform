meta {
  name: Verificar MFA y obtener tokens
  type: http
  seq: 9
}
post {
  url: http://127.0.0.1:3000/api/v1/auth/mfa/verify
  body: json
  auth: none
}
headers {
  X-IPC-Client: admin
  Content-Type: application/json
}
body:json {
  {
    "challengeToken": "{{challengeToken}}",
    "code": "{{mfaCode}}"
  }
}
script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("accessToken", res.getBody().data.accessToken);
    bru.setVar("csrfToken", res.getBody().data.csrfToken);
    bru.setVar("challengeToken", "");
  }
}
