meta {
  name: Iniciar sesion JWT
  type: http
  seq: 2
}

post {
  url: http://127.0.0.1:3000/api/v1/auth/login
  body: json
  auth: none
}

headers {
  X-IPC-Client: admin
  Content-Type: application/json
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:post-response {
  if (res.getStatus() === 202) {
    bru.setVar("accessToken", "");
    bru.setVar("csrfToken", "");
    bru.setVar("challengeToken", res.getBody().data.challengeToken);
  }
}
